                       (0): Conv2d(32, 32, kernel_size=(3, 9), stride=(1, 2),                       
           padding=(1, 4))                                                                          
                       (1): LeakyReLU(negative_slope=0.1)                                           
                     )                                                                              
                     (4): Sequential(                                                               
                       (0): Conv2d(32, 32, kernel_size=(3, 3), stride=(1, 1),                       
           padding=(1, 1))                                                                          
                       (1): LeakyReLU(negative_slope=0.1)                                           
                     )                                                                              
                   )                                                                                
                 )                                                                                  
                 (conv_post): Conv2d(32, 1, kernel_size=(3, 3), stride=(1, 1),                      
           padding=(1, 1))                                                                          
               )                                                                                    
             )                                                                                      
           )                                                                                        
